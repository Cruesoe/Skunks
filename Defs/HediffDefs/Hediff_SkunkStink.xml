<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>SkunkStinkHediff</defName>
    <label>covered in skunk musk</label>
    <description>This pawn has been sprayed or exposed to potent skunk musk. They smell absolutely terrible.\n\nThe coating lasts about 5 days on its own. Spending an hour outdoors makes it wear off 10% faster until they go inside; spending an hour indoors makes it wear off 10% slower until they go outside.\n\nCan be cleansed surgically: neutroamine or chemfuel remove it immediately (chemfuel may cause burns), while herbal medicine or milk clear it over about a day.</description>
    <hediffClass>Skunks.Hediff_SkunkStink</hediffClass>
    <defaultLabelColor>(0.6, 0.4, 0.7)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_ThoughtSetter">
        <thought>SkunkStinkThought</thought>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint whiff</label>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <PawnBeauty>-2</PawnBeauty>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>stinky</label>
        <statOffsets>
          <PawnBeauty>-2</PawnBeauty>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>reeking</label>
        <statOffsets>
          <PawnBeauty>-2</PawnBeauty>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>overwhelmingly putrid</label>
        <statOffsets>
          <PawnBeauty>-2</PawnBeauty>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
